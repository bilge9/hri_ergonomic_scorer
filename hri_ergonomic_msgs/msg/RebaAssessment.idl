// This IDL defines a REBA (Rapid Entire Body Assessment) ergonomic risk
// assessment for a single tracked body. It mirrors hri_msgs/Skeleton3D:
//   - @key string key: same key as the source hri_msgs::msg::Skeleton3D this
//     assessment was computed from, so a consumer can correlate assessment
//     <-> body without extra bookkeeping. Supported only by rmw_fastrtps
//     and Fast DDS.
//   - std_msgs::msg::Header header: stamp = source skeleton frame's
//     acquisition time.
//   - completeness: fraction (0.0-1.0) of the 18 COCO-18 keypoints that had
//     valid 3D data and were actually used in this assessment.
//   - score_a/score_b/score_c/risk_level: REBA Table A/B/C scores and the
//     resulting 5-class risk level.
//   - group_a_valid/group_b_valid: explicit validity flags so a consumer can
//     distinguish "score is 0 because risk is negligible" from "score is 0
//     because we didn't have the joints needed to compute it" -- required
//     for correctly handling incomplete skeletons.
//   - *_assessed / *_known: per-item observation flags. REBA has terms a 3D
//     skeleton simply cannot supply (wrist orientation, carried load, hand
//     coupling, activity over time). Scoring those as their neutral best case
//     and publishing the result as a measurement understates risk, so every
//     item states whether it was actually observed. A score field whose item
//     was not observed carries SCORE_NOT_ASSESSED, never a plausible number.
//   - score_is_lower_bound: true when at least one contributing item was not
//     observed, i.e. the real REBA score can only be higher than the one
//     published. Such a score must not be rendered as a plain risk value.
//
// IMPORTANT for consumers: check the flags before using a score.
// score_c == SCORE_NOT_ASSESSED and risk_level == RISK_UNKNOWN mean no final
// score could be produced for this frame. They do NOT mean low risk.

#include "std_msgs/msg/Header.idl"

module hri_ergonomic_msgs {
  module msg {

    module RebaAssessment_Constants {
      const uint8 RISK_NEGLIGIBLE = 0;  // REBA score 1
      const uint8 RISK_LOW        = 1;  // REBA score 2-3
      const uint8 RISK_MEDIUM     = 2;  // REBA score 4-7
      const uint8 RISK_HIGH       = 3;  // REBA score 8-10
      const uint8 RISK_VERY_HIGH  = 4;  // REBA score 11+

      // No final score could be produced (a whole REBA group was unobservable
      // on this frame). Distinct from every real risk class on purpose.
      const uint8 RISK_UNKNOWN    = 255;

      // Carried by any score field whose underlying item was not observed.
      // No real REBA score can reach 255.
      const uint8 SCORE_NOT_ASSESSED = 255;
    };

    struct RebaAssessment {
      @key string key;

      std_msgs::msg::Header header;

      float completeness;

      // NaN when deba_valid is false. Never read deba_score without it.
      float deba_score;
      boolean deba_valid;

      uint8 score_a;
      uint8 score_b;
      uint8 score_c;
      uint8 risk_level;

      boolean group_a_valid;
      boolean group_b_valid;

      // True when at least one contributing REBA item was not observed, so
      // the published score is a floor on the real risk, not the risk itself.
      boolean score_is_lower_bound;

      float body_confidence[7];
      float arm_confidence[7];

      // Group A (Body) Partial Scores
      uint8 neck_score;
      uint8 trunk_score;
      uint8 leg_score;
      uint8 load_score;

      // Group B (Arm) Partial Scores
      uint8 upper_arm_score;
      uint8 lower_arm_score;
      uint8 wrist_score;
      uint8 coupling_score;

      // Per-item observation flags. False => the matching *_score field is
      // SCORE_NOT_ASSESSED and contributed its neutral value to the group.
      boolean neck_assessed;
      boolean trunk_assessed;
      boolean legs_assessed;
      boolean upper_arm_assessed;
      boolean lower_arm_assessed;
      boolean wrist_assessed;     // always false with a COCO-18 skeleton
      boolean load_known;         // needs a load estimate the vision pipeline cannot give
      boolean coupling_known;     // needs hand/object interaction sensing
      boolean activity_known;     // needs pose history (static/repeated/rapid change)
    };

  };
};